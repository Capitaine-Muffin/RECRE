//===========================================================================
// Trigger: When Building
//===========================================================================
function Trig_When_Building_Func001001 takes nothing returns boolean
    return ( GetOwningPlayer(GetTriggerUnit()) == Player(0) )
endfunction

function Trig_When_Building_Func002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetTriggerUnit()) == Player(1) )
endfunction

function Trig_When_Building_Func003001 takes nothing returns boolean
    return ( GetOwningPlayer(GetTriggerUnit()) == Player(2) )
endfunction

function Trig_When_Building_Func004001 takes nothing returns boolean
    return ( GetOwningPlayer(GetTriggerUnit()) == Player(3) )
endfunction

function Trig_When_Building_Func005001 takes nothing returns boolean
    return ( GetOwningPlayer(GetTriggerUnit()) == Player(4) )
endfunction

function Trig_When_Building_Func006001 takes nothing returns boolean
    return ( GetOwningPlayer(GetTriggerUnit()) == Player(5) )
endfunction

function Trig_When_Building_Func007001 takes nothing returns boolean
    return ( GetOwningPlayer(GetTriggerUnit()) == Player(6) )
endfunction

function Trig_When_Building_Func008001 takes nothing returns boolean
    return ( GetOwningPlayer(GetTriggerUnit()) == Player(7) )
endfunction

function Trig_When_Building_Func009001 takes nothing returns boolean
    return ( GetOwningPlayer(GetTriggerUnit()) == Player(8) )
endfunction

function Trig_When_Building_Func010001 takes nothing returns boolean
    return ( GetOwningPlayer(GetTriggerUnit()) == Player(9) )
endfunction

function Trig_When_Building_Actions takes nothing returns nothing
    if ( Trig_When_Building_Func001001() ) then
        call DisableTrigger( gg_trg_Money4P1 )
    else
        call DoNothing(  )
    endif
    if ( Trig_When_Building_Func002001() ) then
        call DisableTrigger( gg_trg_Money4P2 )
    else
        call DoNothing(  )
    endif
    if ( Trig_When_Building_Func003001() ) then
        call DisableTrigger( gg_trg_Money4P3 )
    else
        call DoNothing(  )
    endif
    if ( Trig_When_Building_Func004001() ) then
        call DisableTrigger( gg_trg_Money4P4 )
    else
        call DoNothing(  )
    endif
    if ( Trig_When_Building_Func005001() ) then
        call DisableTrigger( gg_trg_Money4P5 )
    else
        call DoNothing(  )
    endif
    if ( Trig_When_Building_Func006001() ) then
        call DisableTrigger( gg_trg_Money4P6 )
    else
        call DoNothing(  )
    endif
    if ( Trig_When_Building_Func007001() ) then
        call DisableTrigger( gg_trg_Money4P7 )
    else
        call DoNothing(  )
    endif
    if ( Trig_When_Building_Func008001() ) then
        call DisableTrigger( gg_trg_Money4P8 )
    else
        call DoNothing(  )
    endif
    if ( Trig_When_Building_Func009001() ) then
        call DisableTrigger( gg_trg_Money4P9 )
    else
        call DoNothing(  )
    endif
    if ( Trig_When_Building_Func010001() ) then
        call DisableTrigger( gg_trg_Money4P10 )
    else
        call DoNothing(  )
    endif
endfunction

//===========================================================================
function InitTrig_When_Building takes nothing returns nothing
    set gg_trg_When_Building = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_When_Building, Player(0), EVENT_PLAYER_UNIT_CONSTRUCT_START )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_When_Building, Player(1), EVENT_PLAYER_UNIT_CONSTRUCT_START )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_When_Building, Player(2), EVENT_PLAYER_UNIT_CONSTRUCT_START )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_When_Building, Player(3), EVENT_PLAYER_UNIT_CONSTRUCT_START )
