function Trig_Balloon4T1_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetConstructedStructure()) == 'oC33' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Balloon4T1_Actions takes nothing returns nothing
    call ReplaceUnitBJ( GetConstructedStructure(), 'hC32', bj_UNIT_STATE_METHOD_RELATIVE )
    call SetUnitOwner( GetLastReplacedUnitBJ(), Player(10), false )
    call IssuePointOrderLocBJ( GetLastReplacedUnitBJ(), "move", GetRectCenter(gg_rct_zone_morveux) )
endfunction

