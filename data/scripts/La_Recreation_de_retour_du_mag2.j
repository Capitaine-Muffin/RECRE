    if ( Trig_When_Building_Func001001() ) then
        call DisableTrigger( gg_trg_Money4P1 )
    else
        call DoNothing(  )
    endif
    if ( Trig_When_Building_Func002001() ) then
        call DisableTrigger( gg_trg_Money4P2 )
