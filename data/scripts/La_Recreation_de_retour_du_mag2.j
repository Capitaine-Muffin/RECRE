endfunction

function Trig_Melee_Initialization_Actions takes nothing returns nothing
    call SetTimeOfDay( 12 )
    call UseTimeOfDayBJ( false )
    call ForForce( GetPlayersAll(), function Trig_Melee_Initialization_Func004002 )
    call ForForce( GetPlayersAll(), function Trig_Melee_Initialization_Func005002 )
    call ForForce( GetPlayersAll(), function Trig_Melee_Initialization_Func006002 )
    call ForForce( GetPlayersAll(), function Trig_Melee_Initialization_Func007002 )
    call ForForce( GetPlayersAll(), function Trig_Melee_Initialization_Func008002 )
    call ForForce( GetPlayersAll(), function Trig_Melee_Initialization_Func009002 )
    call FogMaskEnableOff(  )
    call FogEnableOff(  )
endfunction

