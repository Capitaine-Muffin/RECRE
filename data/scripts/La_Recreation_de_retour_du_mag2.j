//*
//*  Map Configuration
//*
//***************************************************************************

function config takes nothing returns nothing
    call SetMapName( "TRIGSTR_037" )
    call SetMapDescription( "TRIGSTR_299" )
    call SetPlayers( 12 )
    call SetTeams( 12 )
    call SetGamePlacement( MAP_PLACEMENT_TEAMS_TOGETHER )

    call DefineStartLocation( 0, -3200.0, -2496.0 )
    call DefineStartLocation( 1, -3392.0, -2496.0 )
    call DefineStartLocation( 2, -3456.0, -2496.0 )
    call DefineStartLocation( 3, -3584.0, -2496.0 )
    call DefineStartLocation( 4, -3712.0, -2496.0 )
    call DefineStartLocation( 5, 3712.0, 2432.0 )
    call DefineStartLocation( 6, 3520.0, 2496.0 )
    call DefineStartLocation( 7, 3456.0, 2432.0 )
    call DefineStartLocation( 8, 3328.0, 2432.0 )
    call DefineStartLocation( 9, 3200.0, 2432.0 )
    call DefineStartLocation( 10, -3520.0, -2944.0 )
    call DefineStartLocation( 11, 3520.0, 2880.0 )

    // Player setup
    call InitCustomPlayerSlots(  )
    call InitCustomTeams(  )
    call InitAllyPriorities(  )
endfunction

