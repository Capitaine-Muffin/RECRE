endfunction

function Trig_Firecracker_Actions takes nothing returns nothing
    call ForGroupBJ( GetUnitsOfPlayerMatching(Player(0), Condition(function Trig_Firecracker_Func001001002)), function Trig_Firecracker_Func001002 )
    call ForGroupBJ( GetUnitsOfPlayerMatching(Player(1), Condition(function Trig_Firecracker_Func002001002)), function Trig_Firecracker_Func002002 )
    call ForGroupBJ( GetUnitsOfPlayerMatching(Player(2), Condition(function Trig_Firecracker_Func003001002)), function Trig_Firecracker_Func003002 )
    call ForGroupBJ( GetUnitsOfPlayerMatching(Player(3), Condition(function Trig_Firecracker_Func004001002)), function Trig_Firecracker_Func004002 )
    call ForGroupBJ( GetUnitsOfPlayerMatching(Player(4), Condition(function Trig_Firecracker_Func005001002)), function Trig_Firecracker_Func005002 )
    call ForGroupBJ( GetUnitsOfPlayerMatching(Player(5), Condition(function Trig_Firecracker_Func006001002)), function Trig_Firecracker_Func006002 )
    call ForGroupBJ( GetUnitsOfPlayerMatching(Player(6), Condition(function Trig_Firecracker_Func007001002)), function Trig_Firecracker_Func007002 )
    call ForGroupBJ( GetUnitsOfPlayerMatching(Player(7), Condition(function Trig_Firecracker_Func008001002)), function Trig_Firecracker_Func008002 )
    call ForGroupBJ( GetUnitsOfPlayerMatching(Player(8), Condition(function Trig_Firecracker_Func009001002)), function Trig_Firecracker_Func009002 )
    call ForGroupBJ( GetUnitsOfPlayerMatching(Player(9), Condition(function Trig_Firecracker_Func010001002)), function Trig_Firecracker_Func010002 )
    call ForGroupBJ( GetUnitsOfPlayerMatching(Player(10), Condition(function Trig_Firecracker_Func011001002)), function Trig_Firecracker_Func011002 )
    call ForGroupBJ( GetUnitsOfPlayerMatching(Player(11), Condition(function Trig_Firecracker_Func012001002)), function Trig_Firecracker_Func012002 )
    call TriggerSleepAction( 1.00 )
    call EnableTrigger( gg_trg_Money4P1 )
    call EnableTrigger( gg_trg_Money4P10 )
    call EnableTrigger( gg_trg_Money4P2 )
    call EnableTrigger( gg_trg_Money4P3 )
    call EnableTrigger( gg_trg_Money4P4 )
    call EnableTrigger( gg_trg_Money4P5 )
    call EnableTrigger( gg_trg_Money4P6 )
    call EnableTrigger( gg_trg_Money4P7 )
    call EnableTrigger( gg_trg_Money4P8 )
    call EnableTrigger( gg_trg_Money4P9 )
    call ForGroupBJ( GetUnitsOfTypeIdAll('hC26'), function Trig_Firecracker_Func024002 )
endfunction

