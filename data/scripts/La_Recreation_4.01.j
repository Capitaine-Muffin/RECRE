    set gg_trg_ballon_t2 = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_ballon_t2, gg_rct_zone_mioche )
    call TriggerAddCondition( gg_trg_ballon_t2, Condition( function Trig_ballon_t2_Conditions ) )
    call TriggerAddAction( gg_trg_ballon_t2, function Trig_ballon_t2_Actions )
endfunction

