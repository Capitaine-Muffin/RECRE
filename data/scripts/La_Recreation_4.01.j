//===========================================================================
// Trigger: ballon t2
//===========================================================================
function Trig_ballon_t2_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnteringUnit()) == 'hC32' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ballon_t2_Func020002 takes nothing returns nothing
    call CustomVictoryBJ( GetEnumPlayer(), true, true )
endfunction

function Trig_ballon_t2_Func021002 takes nothing returns nothing
    call CustomDefeatBJ( GetEnumPlayer(), "TRIGSTR_409" )
endfunction

function Trig_ballon_t2_Actions takes nothing returns nothing
    call DisableTrigger( gg_trg_team1win )
    call DisableTrigger( gg_trg_team2win )
    call CinematicModeBJ( true, GetPlayersAll() )
    call SetCameraTargetControllerNoZForPlayer( Player(0), gg_unit_oC36_0014, 0, 0, false )
    call SetCameraTargetControllerNoZForPlayer( Player(1), gg_unit_oC36_0014, 0, 0, false )
    call SetCameraTargetControllerNoZForPlayer( Player(2), gg_unit_oC36_0014, 0, 0, false )
    call SetCameraTargetControllerNoZForPlayer( Player(3), gg_unit_oC36_0014, 0, 0, false )
    call SetCameraTargetControllerNoZForPlayer( Player(4), gg_unit_oC36_0014, 0, 0, false )
    call SetCameraTargetControllerNoZForPlayer( Player(5), gg_unit_oC36_0014, 0, 0, false )
    call SetCameraTargetControllerNoZForPlayer( Player(6), gg_unit_oC36_0014, 0, 0, false )
    call SetCameraTargetControllerNoZForPlayer( Player(7), gg_unit_oC36_0014, 0, 0, false )
    call SetCameraTargetControllerNoZForPlayer( Player(8), gg_unit_oC36_0014, 0, 0, false )
    call SetCameraTargetControllerNoZForPlayer( Player(9), gg_unit_oC36_0014, 0, 0, false )
    call SetUnitAnimation( GetTriggerUnit(), "death" )
    call TriggerSleepAction( 1.00 )
    call RemoveUnit( GetTriggerUnit() )
    call PlaySoundBJ( gg_snd_BuildingDeathLargeHuman )
    call ExplodeUnitBJ( gg_unit_oC36_0014 )
    call TriggerSleepAction( 5.00 )
    call ForForce( GetPlayersAllies(Player(5)), function Trig_ballon_t2_Func020002 )
    call ForForce( GetPlayersAllies(Player(0)), function Trig_ballon_t2_Func021002 )
endfunction

