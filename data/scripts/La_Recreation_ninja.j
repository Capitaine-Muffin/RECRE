//===========================================================================
// Trigger: team1win
//===========================================================================
function Trig_team1win_Func013002 takes nothing returns nothing
    call CustomVictoryBJ(GetEnumPlayer(), true, false)
endfunction

function Trig_team1win_Func014002 takes nothing returns nothing
    call CustomDefeatBJ(GetEnumPlayer(), "TRIGSTR_287")
endfunction

function Trig_team1win_Actions takes nothing returns nothing
    call CinematicModeBJ(true, GetPlayersAll())
    call SetCameraTargetControllerNoZForPlayer(Player(0), gg_unit_oC36_0033, 0, 0, false)
    call SetCameraTargetControllerNoZForPlayer(Player(1), gg_unit_oC36_0033, 0, 0, false)
    call SetCameraTargetControllerNoZForPlayer(Player(2), gg_unit_oC36_0033, 0, 0, false)
    call SetCameraTargetControllerNoZForPlayer(Player(3), gg_unit_oC36_0033, 0, 0, false)
    call SetCameraTargetControllerNoZForPlayer(Player(4), gg_unit_oC36_0033, 0, 0, false)
    call SetCameraTargetControllerNoZForPlayer(Player(5), gg_unit_oC36_0033, 0, 0, false)
    call SetCameraTargetControllerNoZForPlayer(Player(6), gg_unit_oC36_0033, 0, 0, false)
    call SetCameraTargetControllerNoZForPlayer(Player(7), gg_unit_oC36_0033, 0, 0, false)
    call SetCameraTargetControllerNoZForPlayer(Player(8), gg_unit_oC36_0033, 0, 0, false)
    call SetCameraTargetControllerNoZForPlayer(Player(9), gg_unit_oC36_0033, 0, 0, false)
    call TriggerSleepAction(5.00)
    call ForForce(GetPlayersAllies(Player(0)), function Trig_team1win_Func013002)
    call ForForce(GetPlayersAllies(Player(5)), function Trig_team1win_Func014002)
endfunction

