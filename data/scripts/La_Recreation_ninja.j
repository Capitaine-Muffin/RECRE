    set gg_trg_team1win=CreateTrigger()
    call TriggerRegisterUnitEvent(gg_trg_team1win, gg_unit_oC36_0033, EVENT_UNIT_DEATH)
    call TriggerAddAction(gg_trg_team1win, function Trig_team1win_Actions)
endfunction

