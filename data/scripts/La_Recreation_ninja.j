//===========================================================================
function Trig_KidDeath4T1_Func007001 takes nothing returns boolean
    return ( GetUnitTypeId(GetTriggerUnit()) == 'oC06' )
endfunction

function Trig_KidDeath4T1_Func007002 takes nothing returns boolean
    return ( GetUnitTypeId(GetTriggerUnit()) == 'oC00' )
endfunction

function Trig_KidDeath4T1_Conditions takes nothing returns boolean
    if ( not GetBooleanOr(Trig_KidDeath4T1_Func007001(), Trig_KidDeath4T1_Func007002()) ) then
        return false
    endif
    return true
endfunction

function Trig_KidDeath4T1_Func003001001 takes nothing returns boolean
    return ( GetOwningPlayer(GetTriggerUnit()) == GetFilterPlayer() )
endfunction

function Trig_KidDeath4T1_Actions takes nothing returns nothing
    call CreateNUnitsAtLocFacingLocBJ(1, 'nC12', Player(PLAYER_NEUTRAL_PASSIVE), GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()))
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", GetRectCenter(gg_rct_ToSchool))
    call DisplayTimedTextToForce(GetPlayersMatching(Condition(function Trig_KidDeath4T1_Func003001001)), 15.00, "TRIGSTR_066")
    call TriggerSleepAction(60.00)
    call CreateNUnitsAtLoc(1, 'oC00', GetOwningPlayer(GetTriggerUnit()), GetRectCenter(gg_rct_Base1), bj_UNIT_FACING)
    call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetLastCreatedUnit()), 1.00)
endfunction

