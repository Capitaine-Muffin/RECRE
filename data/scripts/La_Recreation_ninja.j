function InitTrig_KidDeath4T1 takes nothing returns nothing
    set gg_trg_KidDeath4T1=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_KidDeath4T1, Player(0), EVENT_PLAYER_UNIT_DEATH)
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_KidDeath4T1, Player(1), EVENT_PLAYER_UNIT_DEATH)
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_KidDeath4T1, Player(2), EVENT_PLAYER_UNIT_DEATH)
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_KidDeath4T1, Player(3), EVENT_PLAYER_UNIT_DEATH)
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_KidDeath4T1, Player(4), EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_KidDeath4T1, Condition(function Trig_KidDeath4T1_Conditions))
    call TriggerAddAction(gg_trg_KidDeath4T1, function Trig_KidDeath4T1_Actions)
endfunction

//===========================================================================
// Trigger: KidDeath4T2
//===========================================================================
function Trig_KidDeath4T2_Func007001 takes nothing returns boolean
    return ( GetUnitTypeId(GetTriggerUnit()) == 'oC06' )
endfunction

function Trig_KidDeath4T2_Func007002 takes nothing returns boolean
    return ( GetUnitTypeId(GetTriggerUnit()) == 'oC00' )
endfunction

function Trig_KidDeath4T2_Conditions takes nothing returns boolean
    if ( not GetBooleanOr(Trig_KidDeath4T2_Func007001(), Trig_KidDeath4T2_Func007002()) ) then
        return false
    endif
    return true
endfunction

function Trig_KidDeath4T2_Func003001001 takes nothing returns boolean
    return ( GetOwningPlayer(GetTriggerUnit()) == GetFilterPlayer() )
endfunction

function Trig_KidDeath4T2_Actions takes nothing returns nothing
    call CreateNUnitsAtLocFacingLocBJ(1, 'nC12', Player(PLAYER_NEUTRAL_PASSIVE), GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()))
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", GetRectCenter(gg_rct_R__gion_003))
    call DisplayTimedTextToForce(GetPlayersMatching(Condition(function Trig_KidDeath4T2_Func003001001)), 15.00, "TRIGSTR_067")
    call TriggerSleepAction(60.00)
    call CreateNUnitsAtLoc(1, 'oC06', GetOwningPlayer(GetTriggerUnit()), GetRectCenter(gg_rct_Work), bj_UNIT_FACING)
    call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetLastCreatedUnit()), 1.00)
endfunction

//===========================================================================
function InitTrig_KidDeath4T2 takes nothing returns nothing
    set gg_trg_KidDeath4T2=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_KidDeath4T2, Player(5), EVENT_PLAYER_UNIT_DEATH)
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_KidDeath4T2, Player(6), EVENT_PLAYER_UNIT_DEATH)
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_KidDeath4T2, Player(7), EVENT_PLAYER_UNIT_DEATH)
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_KidDeath4T2, Player(8), EVENT_PLAYER_UNIT_DEATH)
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_KidDeath4T2, Player(9), EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_KidDeath4T2, Condition(function Trig_KidDeath4T2_Conditions))
    call TriggerAddAction(gg_trg_KidDeath4T2, function Trig_KidDeath4T2_Actions)
endfunction

